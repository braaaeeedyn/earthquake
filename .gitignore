# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data (large / external)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models / checkpoints
*.pt
*.pth
checkpoints/

# Node / web app
app/node_modules/
app/dist/
app/.vite/

# Capacitor / Android (added later)
app/android/
app/ios/
# built APK served by the /app page — a build artifact, not source
app/public/*.apk

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# Secrets — never commit. SMTP creds for the near-me email alerts live here.
.env
.env.local

# Subscriber list holds personal contact info (name/email/location) — keep local, don't commit.
data/subscribers.json

# Firebase Cloud Messaging (push). The service-account key is a SECRET — never commit.
# google-services.json is app config (not strictly secret) but kept local to be safe.
app/android/app/google-services.json
fcm-service-account.json
data/processed/push_tokens.json
