# Copy this file to ".env" (which is gitignored) and fill in real values.
# The "Contact support" form (scripts/server.py -> /api/contact) reads these to relay a
# message to the hidden support inbox. Without them the form returns "support unavailable".
# NEVER commit the real .env — only this .example template is tracked.

SMTP_USER=braaaeeedyn@gmail.com          # the Gmail account that sends the message
SMTP_PASS=your-16-char-gmail-app-password  # a Google "App password" (NOT your normal login password)
# Optional (defaults shown):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
