# Copy to ".env" (gitignored) and fill in real values. NEVER commit the real .env.
# Loaded by systemd on the VM (EnvironmentFile) and by scripts/mailer.py everywhere else.

# --- live server (VM) ---
PUSH_ENABLED=0                      # 1 = send push alerts; 0 = shadow mode (detect + log only)
SMTP_USER=you@gmail.com             # optional: the "Contact support" form + QuakeOps operator emails
SMTP_PASS=your-16-char-app-password # a Google App password, not your login password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
MLFLOW_TRACKING_URI=http://127.0.0.1:5000   # the registry on the same VM
OPS_EMAIL_TO=you@example.com        # optional: where QuakeOps notices go (defaults to SMTP_USER)
QUAKEOPS_AUTO_DEPLOY=0              # 1 = install a gate-passed champion automatically on the daily pull

# --- PC (training / registry) ---
# MLFLOW_TRACKING_URI=https://mlflow.seismicsocal.duckdns.org
# MLFLOW_TRACKING_USERNAME=quakeops
# MLFLOW_TRACKING_PASSWORD=your-mlflow-password
